# Release signing credentials for the Android APK.
#
# Copy this file to `keystore.properties` (which is gitignored) and fill in your
# values. NEVER commit the real `keystore.properties` or the .jks keystore file.
#
# 1. Generate a keystore yourself (pick your OWN password when prompted):
#      keytool -genkeypair -v -keystore moorix-release.jks -alias moorix \
#        -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Point storeFile at it (absolute path, forward slashes on Windows) and set
#    the same password you chose. `password` is used for both store and key.

storeFile=C:/path/to/moorix-release.jks
keyAlias=moorix
password=CHANGE_ME
